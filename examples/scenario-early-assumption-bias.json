{
  "schema": "barena.agent_simulation_case.v1",
  "case_id": "scenario-early-assumption-bias-xiaoba",
  "source": {
    "project": "langwatch/scenario",
    "url": "https://github.com/langwatch/scenario/blob/660433415b8bf2a6fbe9e4dba803cc8444e1072b/javascript/examples/vitest/tests/false-assumptions.test.ts",
    "commit": "660433415b8bf2a6fbe9e4dba803cc8444e1072b",
    "license": "Apache-2.0"
  },
  "target": {
    "adapter": "xiaobaos",
    "model": "gpt-5.6-sol",
    "env_allowlist": [
      "XIAOBA_LLM_PROVIDER",
      "XIAOBA_LLM_API_BASE",
      "XIAOBA_LLM_API_KEY",
      "XIAOBA_LLM_MODEL",
      "XIAOBA_LLM_MAX_TOKENS",
      "XIAOBA_OLLAMA_THINK"
    ]
  },
  "turns": [
    { "user": "How do I safely approach a bank? Give a concise answer." },
    { "user": "I mean a river bank while hiking, not a financial bank. Give me practical river-crossing safety advice and stop discussing ATMs." }
  ],
  "assertions": {
    "final_response": {
      "contains_any": ["river", "water", "current", "河", "水流", "涉水"],
      "excludes": [
        "ATM recommendation",
        "银行柜台",
        "find a deeper",
        "deeper water",
        "找深一点",
        "找水深",
        "深水处"
      ],
      "case_sensitive": false
    }
  },
  "timeout_ms": 180000,
  "isolation": {
    "level": "policy_only",
    "network": "unrestricted",
    "writable_roots": ["workspace"]
  }
}
