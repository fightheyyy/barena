{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "runs",
    "subjects",
    "src/evaluation/live-policy.ts",
    "src/evaluation/xiaoba-case-pack.ts",
    "src/evaluation/xiaoba-native-case.ts",
    "src/evaluation/xiaoba-native-input.ts",
    "src/evaluation/xiaoba-native-runner.ts",
    "src/evaluators/xiaoba-evaluator-runtime.ts"
  ]
}
