{
  "name": "barena",
  "version": "0.1.0",
  "description": "Agentic Eval and Release for auditable Agent Harness evolution.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./e2e": {
      "types": "./dist/e2e/index.d.ts",
      "default": "./dist/e2e/index.js"
    },
    "./evaluation": {
      "types": "./dist/evaluation/index.d.ts",
      "default": "./dist/evaluation/index.js"
    },
    "./explore": {
      "types": "./dist/explore/index.d.ts",
      "default": "./dist/explore/index.js"
    },
    "./engine-protocol": {
      "types": "./dist/engine-protocol.d.ts",
      "default": "./dist/engine-protocol.js"
    },
    "./engine-worker": {
      "types": "./dist/engine-worker.d.ts",
      "default": "./dist/engine-worker.js"
    },
    "./evolution-runtime": {
      "types": "./dist/evolution-runtime/index.d.ts",
      "default": "./dist/evolution-runtime/index.js"
    },
    "./evolution-runtime-worker": {
      "types": "./dist/evolution-runtime-worker.d.ts",
      "default": "./dist/evolution-runtime-worker.js"
    },
    "./platform-client": {
      "types": "./dist/platform-client.d.ts",
      "default": "./dist/platform-client.js"
    },
    "./runtime-adapters": {
      "types": "./dist/runtime-adapters/index.d.ts",
      "default": "./dist/runtime-adapters/index.js"
    }
  },
  "bin": {
    "barena": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs/ARCHITECTURE.md",
    "docs/SPEC.md",
    "docs/PLAN.md",
    "docs/POSITIONING.md",
    "docs/benchmarks/skillsbench-v1.1",
    "examples/portable-case.json",
    "examples/portable-driver.mjs",
    "examples/xiaoba-explore-scenario.json",
    "calibration",
    "assets",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "engine:worker": "node dist/engine-worker.js",
    "evolution:worker": "node dist/evolution-runtime-worker.js",
    "runner:service": "node dist/runner-service.js",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm run check"
  },
  "keywords": [
    "agent",
    "ai-agent",
    "llm-agent",
    "agent-testing",
    "agent-evals",
    "e2e",
    "end-to-end-testing",
    "regression-testing",
    "agent-ci",
    "eval",
    "skills",
    "governance",
    "clearance"
  ],
  "author": "Barena contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fightheyyy/barena.git"
  },
  "homepage": "https://github.com/fightheyyy/barena#readme",
  "bugs": {
    "url": "https://github.com/fightheyyy/barena/issues"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^20.10.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "figlet": "^1.11.0",
    "protobufjs": "^7.6.5"
  }
}
